SECRET_KEY=cambia-esta-clave-en-produccion
JWT_SECRET_KEY=cambia-esta-clave-jwt
DOMINIO_INSTITUCIONAL=usanjose.edu.co
ORIGENES_PERMITIDOS=*

# Deja DATABASE_URL sin setear para usar SQLite local (por defecto). En
# producción (Render u otro host) se setea automáticamente a la URL de
# Postgres — no uses una ruta relativa aquí, se resuelve mal según el
# directorio de trabajo desde el que se invoque el proceso.
# DATABASE_URL=postgresql://usuario:clave@host:5432/nombre_bd

# Opcional: si tu host no tiene disco persistente (p.ej. Render free), sube
# las imágenes a Cloudinary en vez de a disco local.
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Opcional: promueve este correo a admin automáticamente al arrancar (para
# hosts sin acceso a shell, donde no se puede correr `flask crear-admin`).
# ADMIN_BOOTSTRAP_EMAIL=tu-correo@usanjose.edu.co
